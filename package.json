    "@uploadthing/react": "^7.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "lucide-react": "^0.544.0",
    "mysql2": "^3.24.5",
    "next": "16.4.0",
    "posthog-js": "^1.438.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "uploadthing": "^7.7.4",
