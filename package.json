    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.30.6",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.27.0"
